<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphavibe.investanchorsimport</string>
    <!-- 定錨產業筆記文章自動匯入（specs/010）。正式環境跑獨立 worktree AlphaVibe-prod（見 ops/deploy.sh）；
         帳密／金鑰一律從鑰匙圈讀取，這裡不放任何秘密。每晚一天一次，只在有新文章線索或回補未完成時才登入。
         尚未安裝：T055 由 PO 在場同意後才 launchctl bootstrap。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/stander/My_project/AlphaVibe-prod/poc/kb-mcp/investanchors_import.py</string>
        <string>--data-dir</string>
        <string>/Users/stander/My_project/AlphaVibe-prod/poc/data</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/stander/My_project/AlphaVibe-prod</string>
    <!-- AlphaVibe-prod/poc/data 是指向正式資料目錄的 symlink，article_data_guard 以 realpath 判斷，
         所以必須明確帶 ALPHAVIBE_ALLOW_PRODUCTION_WRITE=1，否則程式會拒絕啟動。
         PATH 含 /opt/homebrew/bin（node 等工具）。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>ALPHAVIBE_ALLOW_PRODUCTION_WRITE</key>
        <string>1</string>
    </dict>
    <!-- 每晚 23:00（PO 決定）。避開既有排程：02:00、03:30、03:45、04:00、06:00、07:45、09:30、17:00、20:15、23:15、週一 10:00。
         刻意不設 RunAtLoad／KeepAlive：安裝或開機時不得立即登入。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/stander/Library/Logs/alphavibe-investanchors.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stander/Library/Logs/alphavibe-investanchors.err.log</string>
</dict>
</plist>
